PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/hireflow
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Optional Cloudinary integration (resume uploads can be metadata-only without it)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI Integration (Official @google/genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=false

# Optional Bootstrap Administrator Configuration (scripts/createAdmin.js)
BOOTSTRAP_ADMIN_NAME=HireFlow Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
